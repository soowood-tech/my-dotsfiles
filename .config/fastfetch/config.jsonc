{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰅂 ",
    "color": {
      "keys": "cyan",
      "title": "magenta"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored} @ {host-name-colored}"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "󰞷 Terminal",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
