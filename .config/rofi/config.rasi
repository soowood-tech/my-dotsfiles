configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "APPS";
    display-run: "RUN";
    display-window: "WINDOW";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
}

@theme "/dev/null"
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
}

window {
    width: 600px;
    height: 420px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
    padding: 20px;
}

mainbox {
    children: [inputbar, listview];
    spacing: 15px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 8px 14px;
    border: 1px;
    border-color: @border-col;
}

prompt {
    text-color: @accent;
    padding: 0 10px 0 0;
}

entry {
    placeholder: "Поиск...";
    placeholder-color: #666677;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 6px;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    children: [element-icon, element-text];
    spacing: 12px;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

element selected {
    background-color: @accent;
    text-color: #ffffff;
}

element-text selected {
    text-color: #ffffff;
}
